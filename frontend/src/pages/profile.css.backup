/* =========================================
   PROFILE SETUP PAGE
========================================= */

.profile-page {
  min-height: 100vh;
  width: 100%;

  display: flex;
  justify-content: center;
  align-items: flex-start;

  padding: 40px 20px 70px;

  box-sizing: border-box;
}


/* =========================================
   CARD
========================================= */

.profile-card {
  width: 100%;
  max-width: 620px;

  padding: 40px;

  box-sizing: border-box;

  border-radius: 26px;

  background: rgba(255, 255, 255, 0.06);

  border: 1px solid rgba(255, 255, 255, 0.10);

  box-shadow:
    0 24px 70px rgba(0, 0, 0, 0.35);
}


/* =========================================
   HEADER
========================================= */

.profile-header {
  text-align: center;

  margin-bottom: 42px;
}

.profile-logo {
  width: 58px;
  height: 58px;

  margin: 0 auto 20px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 18px;

  background: linear-gradient(
    135deg,
    #ffffff,
    #d8d8d8
  );

  box-shadow:
    0 10px 30px rgba(0, 0, 0, 0.20);
}

.logo-z-upper {
  font-size: 31px;
  font-weight: 800;

  line-height: 1;

  color: #111111;
}

.logo-z-lower {
  font-size: 31px;
  font-weight: 500;

  line-height: 1;

  color: #555555;

  margin-left: -3px;
}

.profile-header h1 {
  margin: 0;

  font-size: 31px;

  line-height: 1.2;

  font-weight: 750;
}

.profile-header p {
  margin: 12px auto 0;

  max-width: 440px;

  font-size: 15px;

  line-height: 1.6;

  opacity: 0.65;
}


/* =========================================
   ERROR
========================================= */

.profile-error {
  padding: 13px 16px;

  margin-bottom: 24px;

  border-radius: 12px;

  background: rgba(255, 70, 70, 0.12);

  border: 1px solid rgba(255, 70, 70, 0.25);

  color: #ff8d8d;

  font-size: 14px;

  line-height: 1.5;
}


/* =========================================
   SUCCESS
========================================= */

.profile-success {
  padding: 13px 16px;

  margin-bottom: 24px;

  border-radius: 12px;

  background: rgba(80, 220, 140, 0.12);

  border: 1px solid rgba(80, 220, 140, 0.25);

  color: #7ee2a8;

  font-size: 14px;

  line-height: 1.5;

  text-align: center;
}


/* =========================================
   PROFILE PHOTO SECTION
========================================= */

.profile-photo-section {
  text-align: center;

  padding-bottom: 38px;

  margin-bottom: 38px;

  border-bottom: 1px solid
    rgba(255, 255, 255, 0.09);
}


/* =========================================
   PROFILE PHOTO
========================================= */

.profile-photo-wrapper {
  width: 108px;
  height: 108px;

  margin: 0 auto 18px;

  padding: 3px;

  box-sizing: border-box;

  border-radius: 50%;

  background: linear-gradient(
    135deg,
    #ffffff,
    rgba(255, 255, 255, 0.30)
  );

  box-shadow:
    0 10px 28px rgba(0, 0, 0, 0.22);
}

.profile-photo {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  border-radius: 50%;

  background: #222222;
}


/* =========================================
   PHOTO TEXT
========================================= */

.photo-text h3 {
  margin: 0;

  font-size: 17px;

  font-weight: 650;
}

.photo-text p {
  margin: 7px auto 20px;

  max-width: 360px;

  font-size: 13px;

  line-height: 1.5;

  opacity: 0.60;
}


/* =========================================
   PHOTO BUTTONS
========================================= */

.photo-actions {
  display: flex;

  justify-content: center;

  gap: 10px;

  flex-wrap: wrap;
}

.secondary-button {
  border: 1px solid
    rgba(255, 255, 255, 0.13);

  background: rgba(255, 255, 255, 0.06);

  color: inherit;

  padding: 10px 14px;

  border-radius: 11px;

  cursor: pointer;

  font-size: 13px;

  font-family: inherit;

  transition:
    transform 0.18s ease,
    background 0.18s ease,
    border-color 0.18s ease;
}

.secondary-button:hover:not(:disabled) {
  transform: translateY(-1px);

  background: rgba(255, 255, 255, 0.11);

  border-color:
    rgba(255, 255, 255, 0.22);
}

.secondary-button:active:not(:disabled) {
  transform: translateY(0);
}

.secondary-button:disabled {
  opacity: 0.45;

  cursor: not-allowed;
}


/* =========================================
   FORM
========================================= */

.profile-form {
  display: flex;

  flex-direction: column;

  gap: 32px;
}


/* =========================================
   FORM FIELD
========================================= */

.profile-field {
  display: flex;

  flex-direction: column;

  gap: 10px;
}

.profile-field label {
  font-size: 14px;

  font-weight: 650;
}

.profile-field small {
  font-size: 12px;

  line-height: 1.4;

  opacity: 0.48;
}


/* =========================================
   INPUT / TEXTAREA / SELECT
========================================= */

.profile-field input,
.profile-field textarea,
.profile-field select {
  width: 100%;

  box-sizing: border-box;

  border: 1px solid
    rgba(255, 255, 255, 0.10);

  border-radius: 13px;

  background: rgba(255, 255, 255, 0.07);

  color: inherit;

  padding: 14px 15px;

  font-family: inherit;

  font-size: 15px;

  outline: none;

  transition:
    border-color 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease;
}


/* =========================================
   INPUT
========================================= */

.profile-field input {
  height: 50px;
}


/* =========================================
   TEXTAREA
========================================= */

.profile-field textarea {
  resize: vertical;

  min-height: 110px;

  line-height: 1.5;
}


/* =========================================
   SELECT
========================================= */

.profile-field select {
  height: 50px;

  cursor: pointer;

  appearance: auto;

  color: #ffffff;

  background: rgba(255, 255, 255, 0.07);

  color-scheme: dark;
}

/* Gender dropdown options */
.profile-field select option {
  background: #242424;

  color: #ffffff;

  padding: 12px;
}

/* Selected option */
.profile-field select option:checked {
  background: #3a3a3a;

  color: #ffffff;
}
.profile-field select:hover {
  background: rgba(255, 255, 255, 0.10);

  border-color: rgba(255, 255, 255, 0.20);
}


/* =========================================
   FOCUS
========================================= */

.profile-field input:focus,
.profile-field textarea:focus,
.profile-field select:focus {
  border-color:
    rgba(255, 255, 255, 0.35);

  background:
    rgba(255, 255, 255, 0.10);

  box-shadow:
    0 0 0 3px
    rgba(255, 255, 255, 0.05);
}


/* =========================================
   PLACEHOLDER
========================================= */

.profile-field input::placeholder,
.profile-field textarea::placeholder {
  color: inherit;

  opacity: 0.38;
}


/* =========================================
   FIELD HEADING
========================================= */

.field-heading {
  display: flex;

  align-items: center;

  justify-content: space-between;
}

.field-heading span {
  font-size: 12px;

  opacity: 0.45;
}


/* =========================================
   COMPLETE PROFILE BUTTON
========================================= */

.complete-profile-button {
  width: 100%;

  height: 54px;

  margin-top: 4px;

  border: none;

  border-radius: 15px;

  background: #ffffff;

  color: #111111;

  font-family: inherit;

  font-size: 15px;

  font-weight: 700;

  cursor: pointer;

  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    opacity 0.18s ease;
}

.complete-profile-button:hover:not(:disabled) {
  transform: translateY(-2px);

  box-shadow:
    0 12px 30px rgba(0, 0, 0, 0.22);
}

.complete-profile-button:active:not(:disabled) {
  transform: translateY(0);
}

.complete-profile-button:disabled {
  opacity: 0.55;

  cursor: not-allowed;
}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 600px) {

  .profile-page {
    padding: 24px 14px 45px;
  }

  .profile-card {
    padding: 28px 20px;

    border-radius: 22px;
  }

  .profile-header {
    margin-bottom: 34px;
  }

  .profile-header h1 {
    font-size: 27px;
  }

  .profile-header p {
    font-size: 14px;
  }

  .profile-photo-wrapper {
    width: 96px;
    height: 96px;
  }

  .photo-actions {
    flex-direction: column;
  }

  .secondary-button {
    width: 100%;
  }

  .profile-form {
    gap: 28px;
  }
}